# Local dev uses SQLite. On Render this is the Postgres connection string.
DATABASE_URL="file:./dev.db"

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
# Webhook id from the app's Webhooks section (needed for signature verification)
PAYPAL_WEBHOOK_ID=""

# Sandbox personal accounts used by the seed (payer + payout receiver)
DEMO_CLIENT_PAYPAL_EMAIL="client-buyer@personal.example.com"
DEMO_FREELANCER_PAYPAL_EMAIL="freelancer@personal.example.com"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Platform
PLATFORM_FEE_PCT="3"
AUTO_APPROVE_HOURS="48"
APP_URL="http://localhost:3000"
# Set to "1" to simulate PayPal + LLM when credentials are missing (demo safety net)
SETTLE_MOCK_MODE=""
